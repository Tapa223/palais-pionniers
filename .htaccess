Options -Indexes
DirectoryIndex index.php

# Fichiers de travail jamais servis par le site
<FilesMatch "(?i)(\.(sql|md|log|bak|old|orig|swp|sh|ini|dist|tgz|gz|zip|rar|7z)|~)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_alias.c>
    RedirectMatch 404 /\.git(/|$)
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
